select * from ResumeJobMapping

insert into ResumeJobMapping
values(1, 'Poor_Resume_SSE.pdf', 1),
(2, 'Average_Resume_SSE.pdf', 1),
(3, 'Good_Resume_SSE.pdf', 1),
(4, 'Excellent_Resume_SSE.pdf', 1)

select * from JobFitnessResult

SELECT JobID, JobPosition, JD FROM Jobs

SELECT distinct jfr.ID, jfr.ResumeName, jfr.MatchScore, jfr.MatchSkills, jfr.MissingSkills, jfr.JobID
                    FROM JobFitnessResult jfr
                    WHERE jfr.JobID = 1
                    ORDER BY jfr.MatchScore DESC
                    LIMIT 3</sql><current_tab id="0"/></tab_sql></sqlb_project>
